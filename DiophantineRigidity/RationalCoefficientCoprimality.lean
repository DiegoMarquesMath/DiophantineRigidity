import DiophantineRigidity.ComplexCoprimality
import Mathlib

/-!
# Coefficient coprimality over Q[X] implies absence of common complex roots

The manuscript's coefficient coprimality condition is expressed by
a finite ideal of Q[X] being the unit ideal. The image of this ideal
under evaluation at any complex point cannot be zero, since the
evaluation homomorphism sends 1 to 1.

This removes the previously assumed pointwise non-common-zero
condition in the selected-integer-polynomial argument.

The equivalence between this unit ideal and a particular manuscript
normalization of the coefficient gcd is still a separate source
correspondence task.
-/

noncomputable section
namespace DiophantineRigidity

/-- The ideal generated by a coefficient polynomial A and the
finitely many coefficient polynomials V₀,...,Vₖ over Q[X]. -/
def rationalCoefficientIdeal
    (A : Polynomial ℚ) (V : ℕ → Polynomial ℚ) (k : ℕ) :
    Ideal (Polynomial ℚ) :=
  Ideal.span (Set.insert A
    (V '' ((Finset.range (k + 1) : Finset ℕ) : Set ℕ)))

/-- The unit-ideal condition over Q[X] excludes common complex zeros.
No Bezout polynomial witness is assumed; only the ideal-theoretic
condition that the coefficients generate the full rational ring. -/
theorem noncommon_root_of_rationalCoefficientIdeal_eq_top
    (A : Polynomial ℚ) (V : ℕ → Polynomial ℚ) (k : ℕ)
    (hspan : rationalCoefficientIdeal A V k = ⊤)
    (ρ : ℂ) (hA : A.eval₂ (algebraMap ℚ ℂ) ρ = 0) :
    ∃ j ≤ k, (V j).eval₂ (algebraMap ℚ ℂ) ρ ≠ 0 := by
  classical
  by_contra hn
  push_neg at hn
  let ev : Polynomial ℚ →+* ℂ :=
    Polynomial.eval₂RingHom (algebraMap ℚ ℂ) ρ
  have hle : rationalCoefficientIdeal A V k ≤ RingHom.ker ev := by
    unfold rationalCoefficientIdeal
    apply Ideal.span_le.mpr
    intro P hP
    rcases Set.mem_insert_iff.mp hP with heq | hmem
    · subst P
      exact (RingHom.mem_ker).mpr (by simpa [ev] using hA)
    · obtain ⟨j, hj, rfl⟩ := hmem
      have hjk : j ≤ k :=
        Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
      exact (RingHom.mem_ker).mpr (by simpa [ev] using hn j hjk)
  have hone : (1 : Polynomial ℚ) ∈ rationalCoefficientIdeal A V k := by
    rw [hspan]
    simp
  have hz : ev (1 : Polynomial ℚ) = 0 :=
    (RingHom.mem_ker).mp (hle hone)
  exact one_ne_zero (by simpa using hz : (1 : ℂ) = 0)

/-- A given rational unit-ideal condition on the original integer
coefficient polynomials implies no common complex zero. -/
theorem noncommon_root_integer_of_rationalCoefficientIdeal_eq_top
    (A : Polynomial ℤ) (V : ℕ → Polynomial ℤ) (k : ℕ)
    (hspan : rationalCoefficientIdeal
      (A.map (Int.castRingHom ℚ))
      (fun j => (V j).map (Int.castRingHom ℚ)) k = ⊤)
    (ρ : ℂ) (hA : A.eval₂ (Int.castRingHom ℂ) ρ = 0) :
    ∃ j ≤ k, (V j).eval₂ (Int.castRingHom ℂ) ρ ≠ 0 := by
  have hcomp :
      (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) =
        Int.castRingHom ℂ := by
    ext z
    simp
  have hr :
      (A.map (Int.castRingHom ℚ)).eval₂ (algebraMap ℚ ℂ) ρ = 0 := by
    rw [Polynomial.eval₂_map, hcomp]
    exact hA
  obtain ⟨j, hj, hnonzero⟩ :=
    noncommon_root_of_rationalCoefficientIdeal_eq_top
      (A.map (Int.castRingHom ℚ))
      (fun j => (V j).map (Int.castRingHom ℚ)) k hspan ρ hr
  refine ⟨j, hj, ?_⟩
  rwa [Polynomial.eval₂_map, hcomp] at hnonzero

/-- Select a bounded integer t, using rational coefficient
coprimality instead of a separately assumed no-common-root property.
The nonzero and degree conditions are stated on the complex image of A;
they follow from the standard integer nonzero/degree conditions. -/
theorem exists_selected_integer_coprime_of_rationalCoefficientIdeal
    (A : Polynomial ℤ) (V : ℕ → Polynomial ℤ)
    (k D : ℕ)
    (hA : A.map (Int.castRingHom ℂ) ≠ 0)
    (hdegree : (A.map (Int.castRingHom ℂ)).natDegree ≤ D)
    (hspan : rationalCoefficientIdeal
      (A.map (Int.castRingHom ℚ))
      (fun j => (V j).map (Int.castRingHom ℚ)) k = ⊤) :
    ∃ t : ℕ, t ≤ k * D ∧
      IsCoprime (A.map (Int.castRingHom ℂ))
        ((selectedIntegerCombination V k t).map
          (Int.castRingHom ℂ)) := by
  apply exists_selected_integer_coprime_complex
    (A.map (Int.castRingHom ℂ)) V k D hA hdegree
  intro ρ hroot
  exact noncommon_root_integer_of_rationalCoefficientIdeal_eq_top
    A V k hspan ρ (by simpa only [Polynomial.eval_map] using hroot)

end DiophantineRigidity
